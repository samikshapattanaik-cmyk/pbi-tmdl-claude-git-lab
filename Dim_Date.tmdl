	partition Dim_Date = calculated
		mode: import
		source =
				ADDCOLUMNS (
					CALENDAR ( DATE ( 2020, 11, 1 ), DATE ( 2021, 1, 31 ) ),
					"Year", YEAR ( [Date] ),
					"MonthNum", MONTH ( [Date] ),
					"MonthName", FORMAT ( [Date], "MMM" ),
					"Quarter", "Q" & FORMAT ( [Date], "Q" ),
					"WeekNum", WEEKNUM ( [Date] ),
					"DayOfWeek", FORMAT ( [Date], "dddd" ),
					"IsWeekend", IF ( WEEKDAY ( [Date], 2 ) > 5, "Weekend", "Weekday" )
				)

	annotation PBI_Id = 8975b0dd4db64028ab1958394c6101ae

