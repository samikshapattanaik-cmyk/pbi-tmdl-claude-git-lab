table 'Metric Selector'
	lineageTag: dea8a033-bb3f-42d2-9865-bc480b3ed5ea

	calculationGroup
		precedence: 2

		calculationItem '▤ Sessions' =
				IF(
				    ISSELECTEDMEASURE([Dynamic_Chart_Headline]),
				    SELECTEDMEASURE(),
				    [total_sessions]
				)

		calculationItem '☗ Users' =
				IF(
				    ISSELECTEDMEASURE([Dynamic_Chart_Headline]),
				    SELECTEDMEASURE(),
				    [Total_users]
				)

		calculationItem '𖤍 New Users' =
				IF(
				    ISSELECTEDMEASURE([Dynamic_Chart_Headline]),
				    SELECTEDMEASURE(),
				    [New Users]
				)

		calculationItem '⎘ Engaged Session' =
				IF(
				    ISSELECTEDMEASURE([Dynamic_Chart_Headline]),
				    SELECTEDMEASURE(),
				    [Engaged Session]
				)

	column 'Calculation group column'
		dataType: string
		lineageTag: 73654f9a-2004-43be-b4e4-71ec514f8291
		summarizeBy: none
		sourceColumn: Name
		sortByColumn: Ordinal

		annotation SummarizationSetBy = Automatic

	column Ordinal
		dataType: int64
		formatString: 0
		lineageTag: 32336bee-c0f8-4ef0-96fa-b9cf85ebf153
		summarizeBy: sum
		sourceColumn: Ordinal

		annotation SummarizationSetBy = Automatic

