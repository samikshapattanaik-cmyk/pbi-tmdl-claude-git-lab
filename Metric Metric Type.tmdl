table 'Metric Metric Type'
	lineageTag: 34e459d2-019b-499c-a5cf-ccfadc649017

	calculationGroup
		precedence: 1

		calculationItem Value = SELECTEDMEASURE()

		calculationItem '% Change DoD' = ```
				VAR NumOfDays = COUNTROWS('Dim_Date')
				VAR CurrentVal = SELECTEDMEASURE()
				VAR PriorVal = 
				    CALCULATE(
				        SELECTEDMEASURE(),
				        DATEADD('Dim_Date'[Date], -NumOfDays, DAY)
				    )
				RETURN
				    DIVIDE(CurrentVal - PriorVal, PriorVal)
				```

			formatStringDefinition = "+0% ▲;-0% ▼;0%"

